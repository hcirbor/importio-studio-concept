{
  "name": "importio-studio-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:quality": "node scripts/check-quality.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test && playwright test --config=playwright.labelled.config.ts",
    "test:e2e:update": "playwright test tests/visual.spec.ts --update-snapshots && playwright test --config=playwright.labelled.config.ts tests/labelled/visual.spec.ts --update-snapshots",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@importio/design-system": "file:../../Import.io design system",
    "@radix-ui/react-alert-dialog": "^1.2.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "cmdk": "^1.1.1",
    "lucide-react": "1.53.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.7",
    "use-sync-external-store": "^1.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "@types/use-sync-external-store": "^1.7.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "knip": "^6.41.0",
    "react-test-renderer": "^19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}
